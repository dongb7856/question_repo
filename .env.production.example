# 生产环境（ECS /opt/question_repo/.env.production）
# 与 autoyt2 共用同一台 ECS、同一 RDS 实例，单独建库 question_repo

# 子路径（autoyt2 nginx 反代 /quiz/ 时保持默认即可）
ROOT_PATH=/quiz

# PostgreSQL（RDS 外网地址示例，与 autoyt2 .env.production 同实例不同库名）
QUESTION_REPO_DB=question_repo
PGHOST=pgm-xxxxx.pg.rds.aliyuncs.com
PGPORT=5432
PGUSER=your_rds_user
PGPASSWORD=your_rds_password

# 启动时是否跳过导入（仅重启服务、不改题库时可设 1）
# SKIP_IMPORT=1

# OCR 仅本机 bb 截图处理时需要，生产容器可不配
# TENCENT_OCR_SECRET_ID=
# TENCENT_OCR_SECRET_KEY=
# TENCENT_OCR_REGION=ap-shanghai
