# PostgreSQL（默认连接本机 question_repo 库）
QUESTION_REPO_DB=question_repo
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=bodong
PGPASSWORD=

# 生产子路径（本地留空，ECS 上为 /quiz）
ROOT_PATH=

# 腾讯云 OCR（与 autoyt2 相同的环境变量名）
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-shanghai

# DeepSeek（与 autoyt2 / web-vehicle 相同的环境变量名，可共用 LLM_API_KEY）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_HTTP_TIMEOUT_SECONDS=60
